# Docker Compose
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=repopilot
POSTGRES_PORT=5432
REDIS_PORT=6379

# Required workbench access token; replace before starting the API.
API_TOKEN=replace-with-a-random-workbench-token

# Stable Fernet key for GitHub credentials; inject and back up independently.
# Generate only in a secure terminal (do not commit the output):
# conda run -n repopilot python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
GITHUB_CREDENTIALS_KEY=

# Local Conda development overrides. Docker Compose injects container hostnames automatically.
DATABASE_URL=postgresql+asyncpg://repopilot:change-this-postgres-password@127.0.0.1:5432/repopilot
REDIS_URL=redis://127.0.0.1:6379/0
